using System;
public class Pessoa{
    public string Nome;
    public int Idade;
    public string Cargo;
    public void Apresentar(){
        Console.WriteLine($"Ola, meu nome é {Nome} e tenho {Idade} anos, sou {Cargo}.");
    }
    public void Salario(){
        if (Cargo == "Gerente"){
            Console.WriteLine($"O salario é 10.000,00");
        }
        else if (Cargo == "Desenvolvedor"){
            Console.WriteLine($"O salario é 5.000,00");
        }
        else if (Cargo == "Estagiario"){
            Console.WriteLine($"O salario é 100,00");
        }
    } 
}
public class Program{
    public static void Main(){
        Pessoa p1 = new Pessoa();
        p1.Idade = 30;
        p1.Nome = "Joao";
        p1.Cargo = "Encanador";
        p1.Apresentar();
        
        Pessoa p2 = new Pessoa();
        p2.Idade = 21;
        p2.Nome = "Claudio";
        p2.Cargo = "Estagiario";
        p2.Apresentar();
        p2.Salario();
        
        Pessoa p3 = new Pessoa();
        p3.Idade = 23;
        p3.Nome = "Luna";
        p3.Cargo = "Gerente";
        p3.Apresentar();
        p3.Salario();
        
        Pessoa p4 = new Pessoa();
        p4.Idade = 25;
        p4.Nome = "Rodrigo";
        p4.Cargo = "Desenvolvedor";
        p4.Apresentar();
        p4.Salario();
    }
}
